# ===== DeepSeek =====
DEEPSEEK_API_KEY=sk-替换成你的真实Key
DEEPSEEK_MODEL=deepseek-chat
# 如果你使用第三方中转，可以改成对应的完整地址
# DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

# ===== 访问控制 =====
# 留空表示不启用密码，仅建议本机开发使用。
# 公网部署务必设置一个强密码。
ACCESS_PASSWORD=change-me
# 通过 HTTPS 访问时设为 true；本地纯 HTTP 调试时设为 false。
COOKIE_SECURE=true
# 登录有效期，默认 7 天
SESSION_TTL_SECONDS=604800

# ===== 限额 =====
MAX_CODE_CHARS=20000
# 深度模式最大输出
MAX_OUTPUT_TOKENS=4096
# 快速模式最大输出，越小越快
QUICK_MAX_OUTPUT_TOKENS=1000
# 修复模式最大输出，修复后代码可能较长
FIX_MAX_OUTPUT_TOKENS=4096
# 编程题评测 / 测试框架审查最大输出
PROBLEM_MAX_OUTPUT_TOKENS=2000
TEST_REVIEW_MAX_OUTPUT_TOKENS=2000

# 文件夹分析（zip）
FOLDER_MAX_FILES=5
FOLDER_MAX_FILE_CHARS=20000
FOLDER_MAX_OUTPUT_TOKENS=1200
MAX_FOLDER_ZIP_BYTES=31457280
UPSTREAM_TIMEOUT_SECONDS=120
RATE_LIMIT_PER_MINUTE=10

# ===== 历史记录 =====
# 默认 data/reviews.db；Docker 会把 ./data 挂载到 /app/data
# REVIEW_DB_PATH=/app/data/reviews.db

# ===== 反向代理 =====
# 用 Docker + Caddy 时设为 true；直接暴露 uvicorn 时保持 false。
TRUST_PROXY=true

# ===== 跨域 =====
# 前后端同源部署时留空即可。
# CORS_ORIGINS=https://your-domain.com
